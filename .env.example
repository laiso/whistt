# The macOS app stores OPENAI_API_KEY in the Keychain (service so.lai.whistt)
# and prompts on first launch. This .env file is only needed for:
#  - the `realtime-probe` CLI in Tools/ (cannot read the app's Keychain entry)
#  - overriding the Keychain key in Xcode via a scheme env var
OPENAI_API_KEY=sk-...

# Optional. Default: gpt-realtime-whisper.
# Other options: gpt-4o-transcribe, gpt-4o-mini-transcribe, whisper-1.
WHISTT_MODEL=gpt-realtime-whisper
