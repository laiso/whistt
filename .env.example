# The macOS app stores each provider's API key in the Keychain
# (service so.lai.whistt) and prompts on first launch. This .env file is
# only needed for:
#  - the provider probe CLIs in Tools/ (cannot read the app's Keychain entries)
#  - overriding Keychain keys in a development launch (e.g. `make debug`,
#    which sets WHISTT_PREFER_ENV_API_KEYS=1)
#
# Only the keys for the providers you use are required.

# OpenAI Realtime (provider "OpenAI — realtime" and realtime-probe).
OPENAI_API_KEY=sk-...

# Google Gemini Live Transcription (provider "Gemini" and gemini-live-probe).
GEMINI_API_KEY=...

# Meta Muse Voice Transcribe (provider "Meta" and meta-live-probe).
META_API_KEY=...

# xAI streaming Speech-to-Text (provider "xAI" and xai-live-probe).
XAI_API_KEY=xai-...

# Microsoft Azure Voice Live (provider "Azure" and azure-voice-live-probe).
# The API key is stored in the Keychain like the other providers; the
# endpoint (e.g. https://<resource>.services.ai.azure.com/) can also be
# saved from the app's Provider Settings… screen. Values set here take
# precedence over the saved settings.
AZURE_SPEECH_API_KEY=...
AZURE_SPEECH_ENDPOINT=https://<resource>.services.ai.azure.com/

# ElevenLabs Scribe v2 Realtime (provider "ElevenLabs" and elevenlabs-scribe-probe).
ELEVENLABS_API_KEY=...

# Optional. Default: gpt-transcribe.
WHISTT_MODEL=gpt-transcribe
