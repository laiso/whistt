.env
debug.log

# Xcode per-user state. Shared scheme lives under xcshareddata/ and IS tracked.
xcuserdata/
*.xcuserstate

# Xcode build output (xcodebuild -derivedDataPath build)
build/

# Local recordings / scratch
*.mov

# Rust build cache for linux/. The daemon sandbox cannot write ~/.cargo, so
# CARGO_HOME is pointed inside the workspace during development.
.cargo-home/
