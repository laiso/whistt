# Copy this to ~/.config/whistt/env and restrict it to the owner:
#
#   install -d -m 700 ~/.config/whistt
#   install -m 600 whistt.env.example ~/.config/whistt/env
#
# The file is read by whistt.service through EnvironmentFile=, so it needs
# NAME=value lines without `export` and without shell expansion.

# Required. Never commit this value.
OPENAI_API_KEY=sk-replace-me

# Optional, non-secret settings. Keep them out of any file that holds a
# credential when you can; they are shown here only to document the names.
# WHISTT_MODEL=gpt-transcribe
# WHISTT_DEVICE=
# WHISTT_LOG=info
